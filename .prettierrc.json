{
	"arrowParens": "always",
	"bracketSpacing": true,
	"printWidth": 120,
	"semi": false,
	"singleQuote": true,
	"useTabs": true,
	"endOfLine": "lf",
	"trailingComma": "es5",
	"overrides": [
		{
			"files": ["*.yml", "*.yaml"],
			"options": {
				"singleQuote": false
			}
		}
	],
	"plugins": ["@ianvs/prettier-plugin-sort-imports"],
	"importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "^[./]"],
	"importOrderParserPlugins": ["typescript"],
	"importOrderTypeScriptVersion": "6.0.0",
	"importOrderCaseSensitive": false
}
